# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
LOCALAPI_DATABASE=/app/data/localapi.sqlite

# Optional first key when the keys table is empty. lk_live_... or lk_test_...
# LOCALAPI_BOOTSTRAP_KEY=lk_live_replace_me

# Off by default. Set to 1 (or true) for live public Maps pages.
# LOCALAPI_MAPS_API_KEY is optional (Places SKU path). Leave unset in CI.
# Default remains the 30-place US/UK fixture adapter.
LOCALAPI_LIVE=0
# LOCALAPI_MAPS_API_KEY=
